# Public — available in the browser (Axios base URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only — NEVER add NEXT_PUBLIC_ prefix to these
# They are used only in Next.js Route Handlers (app/api/auth/*)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/redirect/login
